{
  "compilerOptions": {
    "esModuleInterop": true,
    "target": "es2022",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "outDir": "dist",
    "module": "ES2022",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "cypress", "cypress-axe", "cypress-wait-until"],
    "moduleResolution": "bundler"
  },
  "include": ["cypress/**/*.ts", "cypress*.config.ts"]
}
