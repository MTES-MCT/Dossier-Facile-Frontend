{
  "name": "dossierfacile",
  "private": true,
  "license": "MIT",
  "version": "3.5.15",
  "description": "Frontend for DossierFacile",
  "scripts": {
    "dev": "pnpm --parallel --filter www --filter tenantv3 --filter owner dev",
    "dev:www": "pnpm --filter www dev",
    "dev:tenant": "pnpm --parallel --filter www --filter tenantv3 dev",
    "dev:owner": "pnpm --parallel --filter www --filter owner dev",
    "dev:watermark": "pnpm --filter watermark dev",
    "dev:storybook": "pnpm --filter storybook storybook",
    "dev:e2e": "pnpm --filter e2e-tests cy:open"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:MTES-MCT/Dossier-Facile-Frontend.git"
  },
  "engines": {
    "node": "22.x",
    "pnpm": "^10.26.0"
  },
  "packageManager": "pnpm@10.26.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "cypress",
      "@parcel/watcher",
      "@sentry/cli",
      "esbuild"
    ],
    "overrides": {
      "glob": "13.0.0",
      "systeminformation": "5.31.6",
      "js-yaml": "4.1.1",
      "follow-redirects": "1.16.0",
      "picomatch": "2.3.2",
      "postcss": "8.5.13",
      "@isaacs/brace-expansion": "5.0.1",
      "brace-expansion": "5.0.7",
      "minimatch": "10.2.3",
      "rollup": "4.59.0",
      "uuid": "14.0.0",
      "@cypress/request>uuid": "8.3.2",
      "@babel/core": "7.29.6",
      "form-data": "4.0.6",
      "tmp": "0.2.7"
    }
  }
}
