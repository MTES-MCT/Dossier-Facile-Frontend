{
  "name": "dossierfacile",
  "private": true,
  "license": "MIT",
  "version": "3.6.1",
  "description": "Frontend for DossierFacile",
  "scripts": {
    "dev": "pnpm --parallel --filter www --filter tenantv3 --filter owner dev",
    "dev:www": "pnpm --filter www dev",
    "dev:tenant": "pnpm --parallel --filter www --filter tenantv3 dev",
    "dev:owner": "pnpm --parallel --filter www --filter owner dev",
    "dev:watermark": "pnpm --filter watermark dev",
    "test:unit": "pnpm -r --if-present test:unit --run",
    "test:component": "pnpm --filter tenantv3 test:component",
    "test:component:open": "pnpm --filter tenantv3 test:component:open",
    "test:e2e": "pnpm --filter e2e-tests test",
    "test:e2e:open": "pnpm --filter e2e-tests cy:open",
    "test:e2e:agent": "pnpm --filter e2e-tests cy:open-agent",
    "test:integration": "pnpm --filter e2e-tests test:integration",
    "test:integration:open": "pnpm --filter e2e-tests cy:open-integration"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:MTES-MCT/Dossier-Facile-Frontend.git"
  },
  "engines": {
    "node": ">=26",
    "pnpm": "^12.x"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
